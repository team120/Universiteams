# Dev environment variables. Copy this file to docker.dev.env (see README).

# --- Config: safe defaults for the local Docker stack, no changes needed ---

FRONTEND_HOST="http://localhost:3000"
FORGET_PASSWORD_URL="http://localhost:3000/account/resetPassword"
EMAIL_CONFIRMATION_URL="http://localhost:3000/account/verifyEmail"
SAME_SITE_POLICY="none"
SECURE_COOKIE="true"
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="universiteams"
REDIS_HOST="redis"
REDIS_PORT="6379"
EMAIL_USER="info@universiteams.com"
SUPER_ADMIN_EMAIL="admin@example.com"

# --- Secrets: replace every change-me value, never commit the real ones ---

POSTGRES_USER="change-me"
POSTGRES_PASSWORD="change-me"
ACCESS_TOKEN_SECRET="change-me"
REFRESH_TOKEN_SECRET="change-me"
EMAIL_VERIFICATION_LINK_SECRET="change-me"
FORGET_PASSWORD_VERIFICATION_LINK_SECRET="change-me"
SENDGRID_API_KEY="change-me"
SENDINBLUE_API_KEY="change-me"
SUPER_ADMIN_PASSWORD="change-me"
